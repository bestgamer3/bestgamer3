# Character
CHARACTER_NAME=Nova

# Ollama AI brain
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3

# Persistent short-term conversation memory
MEMORY_FILE=data/memory.json
MEMORY_MAX_MESSAGES=24

# Offline text-to-speech
TTS_ENABLED=true
TTS_RATE=185
TTS_VOLUME=1.0

# VTube Studio integration
VTS_ENABLED=false
VTS_URL=ws://127.0.0.1:8001
VTS_TOKEN_FILE=.vts_token
VTS_PLUGIN_NAME=Nova AI VTuber
VTS_PLUGIN_DEVELOPER=bestgamer3

# These must match hotkey names in your VTube Studio model.
VTS_HOTKEY_HAPPY=Happy
VTS_HOTKEY_SAD=Sad
VTS_HOTKEY_ANGRY=Angry
VTS_HOTKEY_SHOCKED=Shocked
VTS_HOTKEY_SMUG=Smug
VTS_HOTKEY_NEUTRAL=Neutral

MAX_OUTPUT_CHARS=500
